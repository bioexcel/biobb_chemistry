{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://bioexcel.eu/biobb_chemistry/json_schemas/1.0/acpype_params_gmx_opls",
    "name": "biobb_chemistry AcpypeParamsGMXOPLS",
    "title": "This class is a wrapper of Acpype tool for generation of topologies for OPLS/AA.",
    "description": "Generation of topologies for OPLS/AA. Acpype is a tool based in Python to use Antechamber to generate topologies for chemical compounds and to interface with others python applications like CCPN or ARIA. Visit the official page.",
    "type": "object",
    "info": {
        "wrapped_software": {
            "name": "Acpype",
            "version": "2019.10.05.12.26",
            "license": "GNU"
        },
        "ontology": {
            "name": "EDAM",
            "schema": "http://edamontology.org/EDAM.owl"
        }
    },
    "required": [
        "input_path",
        "output_path_itp",
        "output_path_top"
    ],
    "properties": {
        "input_path": {
            "type": "string",
            "description": "Path to the input file",
            "filetype": "input",
            "sample": "https://github.com/bioexcel/biobb_chemistry/raw/master/biobb_chemistry/test/data/acpype/acpype.params.mol2",
            "enum": [
                ".*\\.pdb$",
                ".*\\.mdl$",
                ".*\\.mol2$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.pdb$",
                    "description": "Path to the input file",
                    "edam": "format_1476"
                },
                {
                    "extension": ".*\\.mdl$",
                    "description": "Path to the input file",
                    "edam": "format_3815"
                },
                {
                    "extension": ".*\\.mol2$",
                    "description": "Path to the input file",
                    "edam": "format_3816"
                }
            ]
        },
        "output_path_itp": {
            "type": "string",
            "description": "Path to the ITP output file",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_chemistry/raw/master/biobb_chemistry/test/reference/acpype/ref_acpype.gmx.opls.itp",
            "enum": [
                ".*\\.itp$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.itp$",
                    "description": "Path to the ITP output file",
                    "edam": "format_3883"
                }
            ]
        },
        "output_path_top": {
            "type": "string",
            "description": "Path to the TOP output file",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_chemistry/raw/master/biobb_chemistry/test/reference/acpype/ref_acpype.gmx.opls.top",
            "enum": [
                ".*\\.top$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.top$",
                    "description": "Path to the TOP output file",
                    "edam": "format_3880"
                }
            ]
        },
        "properties": {
            "type": "object",
            "properties": {
                "basename": {
                    "type": "string",
                    "default": "BBB",
                    "wf_prop": false,
                    "description": "A basename for the project (folder and output files)."
                },
                "charge": {
                    "type": "integer",
                    "default": null,
                    "wf_prop": false,
                    "description": "Net molecular charge, for gas default is 0. If None the charge is guessed by acpype.",
                    "min": -20,
                    "max": 20,
                    "step": 1
                },
                "charge_method": {
                    "type": "string",
                    "default": "bcc",
                    "wf_prop": false,
                    "description": "Charge method. ",
                    "enum": [
                        "gas",
                        "bcc",
                        "abcg2",
                        "user"
                    ],
                    "property_formats": [
                        {
                            "name": "gas",
                            "description": "Gasteiger charges"
                        },
                        {
                            "name": "bcc",
                            "description": "AM1-BCC charges"
                        },
                        {
                            "name": "abcg2",
                            "description": "ABCG2 charges; recommended for GAFF2; not available in acpype 2023.10.27"
                        },
                        {
                            "name": "user",
                            "description": "charges read from the mol2 input file"
                        }
                    ]
                },
                "multiplicity": {
                    "type": "integer",
                    "default": 1,
                    "wf_prop": false,
                    "description": "Multiplicity (2S+1) of the molecule.",
                    "min": 1,
                    "max": 10,
                    "step": 1
                },
                "atom_type": {
                    "type": "string",
                    "default": "gaff2",
                    "wf_prop": false,
                    "description": "Atom type. ",
                    "enum": [
                        "gaff",
                        "amber",
                        "gaff2",
                        "amber2"
                    ],
                    "property_formats": [
                        {
                            "name": "gaff",
                            "description": "General AMBER Force Field"
                        },
                        {
                            "name": "amber",
                            "description": "protein force field set in protein_ff + GAFF"
                        },
                        {
                            "name": "gaff2",
                            "description": "General AMBER Force Field 2"
                        },
                        {
                            "name": "amber2",
                            "description": "protein force field set in protein_ff + GAFF2"
                        }
                    ]
                },
                "protein_ff": {
                    "type": "string",
                    "default": "ff14SB",
                    "wf_prop": false,
                    "description": "Protein force field used with the amber and amber2 atom types; only written to the command line when it is not the default value, not available in acpype 2023.10.27. ",
                    "enum": [
                        "ff14SB",
                        "ff99SB"
                    ],
                    "property_formats": [
                        {
                            "name": "ff14SB",
                            "description": "AMBER ff14SB"
                        },
                        {
                            "name": "ff99SB",
                            "description": "AMBER ff99SB"
                        }
                    ]
                },
                "qprog": {
                    "type": "string",
                    "default": "sqm",
                    "wf_prop": false,
                    "description": "AM1-BCC charges engine; mopac and divcon need a full external AmberTools. ",
                    "enum": [
                        "sqm",
                        "mopac",
                        "divcon"
                    ],
                    "property_formats": [
                        {
                            "name": "sqm",
                            "description": "sqm"
                        },
                        {
                            "name": "mopac",
                            "description": "MOPAC"
                        },
                        {
                            "name": "divcon",
                            "description": "DivCon"
                        }
                    ]
                },
                "keyword": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Keyword of the mopac or sqm engine, ie: \"qm_theory='AM1', grms_tol=0.0005, scfconv=1.d-10\"."
                },
                "max_time": {
                    "type": "integer",
                    "default": 10800,
                    "wf_prop": false,
                    "description": "Maximum time (in seconds) for the sqm or mopac execution.",
                    "min": 1,
                    "max": 1000000,
                    "step": 1
                },
                "predindex": {
                    "type": "integer",
                    "default": 4,
                    "wf_prop": false,
                    "description": "Antechamber atom and bond type prediction index, the antechamber -j flag; only 1, 4 and 5 produce a topology. Only written to the command line when it is not the default value, not available in acpype 2023.10.27. ",
                    "min": 0,
                    "max": 5,
                    "step": 1,
                    "enum": [
                        0,
                        1,
                        2,
                        3,
                        4,
                        5
                    ],
                    "property_formats": [
                        {
                            "name": 0,
                            "description": "no prediction"
                        },
                        {
                            "name": 1,
                            "description": "atom type"
                        },
                        {
                            "name": 2,
                            "description": "full bond types"
                        },
                        {
                            "name": 3,
                            "description": "part bond types"
                        },
                        {
                            "name": 4,
                            "description": "atom and full bond type"
                        },
                        {
                            "name": 5,
                            "description": "atom and part bond type"
                        }
                    ]
                },
                "gmx4": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Write Ryckaert-Bellemans dihedrals for the old GROMACS 4.0."
                },
                "merge": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Merge lower and uppercase atom types in the GROMACS topology if their parameters match."
                },
                "sorted": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Sort atoms for the GROMACS ordering."
                },
                "binary_path": {
                    "type": "string",
                    "default": "acpype",
                    "wf_prop": false,
                    "description": "Path to the acpype executable binary."
                },
                "remove_tmp": {
                    "type": "boolean",
                    "default": true,
                    "wf_prop": true,
                    "description": "Remove temporal files."
                },
                "restart": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": true,
                    "description": "Do not execute if output files exist."
                },
                "sandbox_path": {
                    "type": "string",
                    "default": "./",
                    "wf_prop": true,
                    "description": "Parent path to the sandbox directory."
                },
                "container_path": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Container path definition."
                },
                "container_image": {
                    "type": "string",
                    "default": "acpype/acpype:2022.7.21",
                    "wf_prop": false,
                    "description": "Container image definition."
                },
                "container_volume_path": {
                    "type": "string",
                    "default": "/tmp",
                    "wf_prop": false,
                    "description": "Container volume path definition."
                },
                "container_working_dir": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Container working directory definition."
                },
                "container_user_id": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Container user_id definition."
                },
                "container_shell_path": {
                    "type": "string",
                    "default": "/bin/bash",
                    "wf_prop": false,
                    "description": "Path to default shell inside the container."
                }
            }
        }
    },
    "additionalProperties": false
}